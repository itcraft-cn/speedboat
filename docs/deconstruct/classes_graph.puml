title Speedboat — Raft分布式主节点选举框架 类图
' Core Module
package "core (cn.itcraft.speedboat)" #LightBlue {
    class Speedboat <<singleton>> {
        + start(SpeedboatConfigProvider) : void
        + stop() : void
        + isMain() : boolean
        + getLeaderId() : String
        + getTerm() : long
        + getNodeId() : String
        + getDatacenterId() : String
        + isRunning() : boolean
        + getLock(String) : DistributedLock
        - doStart() : void
        - doStop() : void
        - nodeId : String
        - localIp : String
        - localPort : int
        - datacenterId : String
        - crossDatacenterMode : boolean
        - nettyTransport : NettyTransport
        - raftNode : RaftNode
        - lockStateMachine : LockStateMachine
        - lockCache : ConcurrentHashMap~String,DistributedLock~
        - running : boolean
    }

    class NodeInfo {
        + NodeInfo(String, String, NodeState, long)
        + getNodeId() : String
        + getDatacenter() : String
        + getState() : NodeState
        + getTerm() : long
        - nodeId : String
        - datacenter : String
        - state : NodeState
        - term : long
    }
}

' Config Module
package "config (cn.itcraft.speedboat.config)" #LightYellow {
    interface SpeedboatConfigProvider {
        + getDatacenter() : String
        + getNodes() : List~List~String~~
        + getIntraDatacenterElectionTimeoutMin() : int
        + getIntraDatacenterElectionTimeoutMax() : int
        + getCrossDatacenterElectionTimeoutMin() : int
        + getCrossDatacenterElectionTimeoutMax() : int
    }

    class PropertiesConfigProvider {
        + PropertiesConfigProvider(String)
        + PropertiesConfigProvider(InputStream)
        + getDatacenter() : String
        + getNodes() : List~List~String~~
        - loadConfig(String) : void
        - parseDatacenterNodes(int) : List~String~
        - properties : Properties
    }

    class SpeedboatConfig {
        + builder() : Builder
        + from(SpeedboatConfig) : Builder
        + getPort() : int
        + getVoteWeightStrategy() : VoteWeightStrategy
        + getGroupStrategy() : GroupStrategy
        + getDatacenterId() : String
        - port : int
        - voteWeightStrategy : VoteWeightStrategy
        - groupStrategy : GroupStrategy
        - datacenterId : String
    }

    class SpeedboatConfig_Builder {
        + port(int) : Builder
        + voteWeightStrategy(VoteWeightStrategy) : Builder
        + groupStrategy(GroupStrategy) : Builder
        + datacenterId(String) : Builder
        + build() : SpeedboatConfig
    }

    class SpeedboatConsts <<utility>> {
        {static} + MIN_ELECTION_TIMEOUT_MS : int = 150
        {static} + MAX_ELECTION_TIMEOUT_MS : int = 300
        {static} + HEARTBEAT_INTERVAL_MS : int = 50
        {static} + GLOBAL_MIN_ELECTION_TIMEOUT_MS : int = 500
        {static} + GLOBAL_MAX_ELECTION_TIMEOUT_MS : int = 1000
        {static} + GLOBAL_HEARTBEAT_INTERVAL_MS : int = 200
        {static} + DEFAULT_PORT : int = 22222
        {static} + GLOBAL_PORT : int = 33333
        {static} + DEFAULT_MAX_LOG_SIZE : int = 10
    }

    class MembershipConfig {
        + getHealthCheckIntervalMs() : int
        + getFailureThreshold() : int
        + getConfirmationPeriods() : int
        + getRegistryImpl() : MembershipConfig_RegistryImpl
        + isMembershipChangeEnabled() : boolean
        + getConfirmationNanos() : long
        - healthCheckIntervalMs : int
        - failureThreshold : int
        - confirmationPeriods : int
        - registryImpl : MembershipConfig_RegistryImpl
        - enableAutoRemoval : boolean
    }

    enum MembershipConfig_RegistryImpl {
        NONE
        NACOS
        REDIS
    }

    class MembershipConfig_Builder {
        + healthCheckIntervalMs(int) : Builder
        + failureThreshold(int) : Builder
        + registryImpl(MembershipConfig_RegistryImpl) : Builder
        + build() : MembershipConfig
