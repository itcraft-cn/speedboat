        + isMain() : boolean
        + getNodeId() : String
        + getLeaderId() : String
        + getTerm() : Term
        + getPeerIds() : List~String~
        + getMembershipConfig() : MembershipConfig
        + getHealthCheckStrategy() : HealthCheckStrategy
        + getRegistryStrategy() : RegistryStrategy
        + getChangeValidationStrategy() : ChangeValidationStrategy
        + getFailureRecords() : Map~String,FailureRecord~
        + proposeAddMember(String) : boolean
        + proposeRemoveMember(String) : boolean
        - handleRequestVote(RequestVoteRequest) : RequestVoteResponse
        - handleHeartbeat(HeartbeatRequest) : HeartbeatResponse
        - handleAppendEntries(AppendEntriesRequest) : AppendEntriesResponse
        - startElection() : void
        - becomeLeader() : void
        - becomeFollower(long) : void
        - nodeId : String
        - currentState : NodeState
        - term : Term
        - votedFor : String
        - leaderId : String
        - electionTimeout : ElectionTimeout
        - voteWeightStrategy : VoteWeightStrategy
        - groupStrategy : GroupStrategy
        - transportLayer : TransportLayer
        - peerIds : List~String~
        - log : List~LogEntry~
        - commitIndex : long
        - lastApplied : long
        - nextIndex : Map~String,Long~
        - matchIndex : Map~String,Long~
        - membershipConfig : MembershipConfig
        - healthCheckStrategy : HealthCheckStrategy
        - registryStrategy : RegistryStrategy
        - changeValidationStrategy : ChangeValidationStrategy
        - failureRecords : Map~String,FailureRecord~
        - stateMachine : StateMachine
    }

    class RaftNode_Builder {
        + nodeId(String) : Builder
        + peerIds(List~String~) : Builder
        + electionTimeout(ElectionTimeout) : Builder
        + voteWeightStrategy(VoteWeightStrategy) : Builder
        + groupStrategy(GroupStrategy) : Builder
        + transportLayer(TransportLayer) : Builder
        + membershipConfig(MembershipConfig) : Builder
        + healthCheckStrategy(HealthCheckStrategy) : Builder
        + registryStrategy(RegistryStrategy) : Builder
        + changeValidationStrategy(ChangeValidationStrategy) : Builder
        + stateMachine(StateMachine) : Builder
        + build() : RaftNode
    }

    class RaftGroup {
        + RaftGroup(String, List~String~, SpeedboatConfig)
        + start() : void
        + shutdown() : void
        + electLeader() : void
        + getLeader() : RaftNode
        + isMain() : boolean
        + setParentGroup(RaftGroup) : void
        + addChildGroup(RaftGroup) : void
        + getParentGroup() : RaftGroup
        + getChildGroups() : List~RaftGroup~
        - groupId : String
        - nodes : List~RaftNode~
        - leader : RaftNode
        - groupStrategy : GroupStrategy
        - parentGroup : RaftGroup
        - childGroups : List~RaftGroup~
        - running : boolean
    }

    class Term {
        + Term()
        + getCurrent() : long
        + increment() : void
        + updateIfHigher(long) : boolean
        + isMonotonicViolation(long) : boolean
        + reset() : void
        - current : long
    }

    class ElectionTimeout {
        + ElectionTimeout(long, long)
        + getNext() : long
        + reset() : void
        + getMinMs() : long
        + getMaxMs() : long
        - minMs : long
        - maxMs : long
        - currentTimeout : long
    }

    enum NodeState {
        LEADER
        FOLLOWER
        CANDIDATE
        + canTransitionTo(NodeState) : boolean
    }

    class VoteContext {
        + VoteContext(String, String, boolean, boolean, long)
        + forCandidate(String, long) : VoteContext
        + forDatacenter(String, String, long) : VoteContext
        - candidateId : String
        - candidateDatacenter : String
        - startupFirst : boolean
        - electionInitiator : boolean
        - term : long
    }

    class FailureRecord {
        + FailureRecord(String)
        + getNodeId() : String
        + getFailureCount() : int
        + incrementFailureCount() : void
        + isConfirmed() : boolean
        + setConfirmed(boolean) : void
        + reset() : void
        + getDurationNanos() : long
        + shouldProposeRemoval(int, long) : boolean
        - nodeId : String
        - firstFailureTime : long
        - failureCount : AtomicInteger
        - confirmed : boolean
    }

    class LeaderRecord {
        + LeaderRecord(long, String)
        + getTerm() : long
        + getLeaderId() : String
        - term : long
        - leaderId : String
    }

    abstract class LogEntry {
        + LogEntry()
        + LogEntry(long, long, String)
        + getIndex() : long
        + getTerm() : long
        + getLeaderId() : String
        + getEntryType() : EntryType
        + getData() : byte[]
        # index : long
        # term : long
        # leaderId : String
        # entryType : LogEntry_EntryType
        # data : byte[]
    }

    enum LogEntry_EntryType {
        LEADER_INFO
        MEMBER_CHANGE
        COMMAND
    }

    class CommandLogEntry {
        + CommandLogEntry(long, long, String, byte[])
        + create(long, long, String, byte[]) : CommandLogEntry
    }

    class MemberChangeEntry {
        + MemberChangeEntry(long, long, String, ChangeType, String, String)
        + add(long, long, String, String, String) : MemberChangeEntry
        + remove(long, long, String, String) : MemberChangeEntry
        + getChangeType() : ChangeType
        + getNodeId() : String
        + getAddress() : String
        - changeType : ChangeType
        - nodeId : String
        - address : String
    }

    enum MemberChangeEntry_ChangeType {
        ADD
        REMOVE
    }

    RaftNode_Builder *-- RaftNode
    RaftNode *-- Term
    RaftNode *-- ElectionTimeout
    RaftNode *-- NodeState
    RaftNode o-- "0..*" FailureRecord
    RaftNode o-- LeaderRecord
    RaftNode o-- "0..*" LogEntry
    RaftGroup o-- "0..*" RaftNode
    RaftGroup o-- RaftGroup : parentGroup
    RaftGroup o-- "0..*" RaftGroup : childGroups
    LogEntry *-- LogEntry_EntryType
    CommandLogEntry --|> LogEntry
    MemberChangeEntry --|> LogEntry
    MemberChangeEntry *-- MemberChangeEntry_ChangeType
}

' Transport Module
package "transport (cn.itcraft.speedboat.transport)" #LightPink {
    interface TransportLayer {
        + sendRequestVote(String, RequestVoteRequest) : CompletableFuture~RequestVoteResponse~
        + sendHeartbeat(String, HeartbeatRequest) : CompletableFuture~HeartbeatResponse~
        + sendAppendEntries(String, AppendEntriesRequest) : CompletableFuture~AppendEntriesResponse~
        + setRequestVoteHandler(RequestVoteHandler) : void
        + setHeartbeatHandler(HeartbeatHandler) : void
        + setAppendEntriesHandler(AppendEntriesHandler) : void
    }

    interface TransportLayer_RequestVoteHandler <<FunctionalInterface>>
    interface TransportLayer_HeartbeatHandler <<FunctionalInterface>>
    interface TransportLayer_AppendEntriesHandler <<FunctionalInterface>>

    class NodeEndpoint {
        + NodeEndpoint(String, String, int)
        + parse(String) : NodeEndpoint
        + getNodeId() : String
        + getHost() : String
        + getPort() : int
        - nodeId : String
        - host : String
        - port : int
    }

    class NettyTransport {
        + NettyTransport(NodeEndpoint, List~NodeEndpoint~, CustomSerializer)
        + start() : void
        + shutdown() : void
        + sendRequestVote(String, RequestVoteRequest) : CompletableFuture~RequestVoteResponse~
        + sendHeartbeat(String, HeartbeatRequest) : CompletableFuture~HeartbeatResponse~
        + sendAppendEntries(String, AppendEntriesRequest) : CompletableFuture~AppendEntriesResponse~
        - connectToPeers() : void
        - bossGroup : EventLoopGroup
        - workerGroup : EventLoopGroup
        - channels : Map~String,Channel~
        - pendingRequests : Map~String,CompletableFuture~
        - localEndpoint : NodeEndpoint
        - peers : List~NodeEndpoint~
        - serializer : CustomSerializer
    }

    class RpcMessageHandler {
        - RpcMessageHandler(NettyTransport, CustomSerializer)
        + channelRead(ChannelHandlerContext, Object) : void
        + exceptionCaught(ChannelHandlerContext, Throwable) : void
        - transport : NettyTransport
        - serializer : CustomSerializer
    }

    class RpcResponseHandler {
        - RpcResponseHandler(NettyTransport, CustomSerializer)
        + channelRead(ChannelHandlerContext, Object) : void
        + exceptionCaught(ChannelHandlerContext, Throwable) : void
        - transport : NettyTransport
        - serializer : CustomSerializer
    }

    NettyTransport ..|> TransportLayer
    NettyTransport *-- NodeEndpoint
    NettyTransport o-- "0..*" NodeEndpoint : peers
    NettyTransport *-- RpcMessageHandler
    NettyTransport *-- RpcResponseHandler
    NettyTransport *-- CustomSerializer
    TransportLayer *-- TransportLayer_RequestVoteHandler
    TransportLayer *-- TransportLayer_HeartbeatHandler
    TransportLayer *-- TransportLayer_AppendEntriesHandler
}

