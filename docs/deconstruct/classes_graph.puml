        + AppendEntriesResponse(long, boolean, long)
        + getTerm() : long
        + isSuccess() : boolean
        + getMatchIndex() : long
        - term : long
        - success : boolean
        - matchIndex : long
    }

    class HeartbeatRequest {
        + HeartbeatRequest()
        + HeartbeatRequest(long, String)
        + getTerm() : long
        + getLeaderId() : String
        - term : long
        - leaderId : String
    }

    class HeartbeatResponse {
        + HeartbeatResponse()
        + HeartbeatResponse(String, long, boolean)
        + HeartbeatResponse(long, boolean)
        + getTerm() : long
        + isSuccess() : boolean
        - term : long
        - success : boolean
    }

    RequestVoteRequest --|> RpcRequest
    AppendEntriesRequest --|> RpcRequest
    HeartbeatRequest --|> RpcRequest
    RequestVoteResponse --|> RpcResponse
    AppendEntriesResponse --|> RpcResponse
