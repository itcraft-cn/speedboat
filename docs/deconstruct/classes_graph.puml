    SpeedboatConfig_Builder *-- SpeedboatConfig
    MembershipConfig_Builder *-- MembershipConfig
    MembershipConfig *-- MembershipConfig_RegistryImpl
    PropertiesConfigProvider ..|> SpeedboatConfigProvider
}

' Raft Module
package "raft (cn.itcraft.speedboat.raft)" #LightGreen {
    class RaftNode {
