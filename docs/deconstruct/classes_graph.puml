}

' Serialize Module
package "serialize (cn.itcraft.speedboat.serialize)" #Wheat {
    interface Serializer {
        + serialize(Object) : byte[]
        + deserialize(byte[], Class~T~) : T
        + getTypeId() : int
    }

    class ProtostuffSerializer {
        + serialize(Object) : byte[]
        + deserialize(byte[], Class~T~) : T
        + getTypeId() : int
        - TYPE_ID : int = 2
    }

    class CustomSerializer {
        + CustomSerializer(Serializer)
        + wrap(Object) : byte[]
        + unwrap(byte[], Class~T~) : T
        - registerType(int, Class~?~) : void
        - HEADER_LEN : int = 10
        - payloadSerializer : Serializer
        - typeToId : Map~Class~?~,Integer~
        - idToType : Map~Integer,Class~?~~
    }

    class SerializationException {
        + SerializationException(String)
        + SerializationException(String, Throwable)
    }

    ProtostuffSerializer ..|> Serializer
    CustomSerializer o-- Serializer : payloadSerializer
    SerializationException --|> RuntimeException
}

' Lock Module
package "lock (cn.itcraft.speedboat.lock)" #Thistle {
    interface DistributedLock {
        + tryLock() : LockHandle
        + tryLock(long) : LockHandle
        + unlock() : void
        + isLocked() : boolean
        + isHeldByCurrentNode() : boolean
        + getLockName() : String
        + getHolderNodeId() : String
    }

    interface LockHandle {
        + isSuccess() : boolean
        + getLockName() : String
        + getNodeId() : String
        + close() : void
    }

    class DistributedLockImpl {
        + DistributedLockImpl(String, String, RaftNode, LockStateMachine)
        + tryLock() : LockHandle
        + tryLock(long) : LockHandle
        + unlock() : void
        + isLocked() : boolean
        + isHeldByCurrentNode() : boolean
        + shutdown() : void
        - tryLockInternal() : boolean
        - startRenewTask() : void
        - stopRenewTask() : void
        - lockName : String
        - nodeId : String
        - raftNode : RaftNode
        - stateMachine : LockStateMachine
        - renewExecutor : ScheduledExecutorService
    }

    class LockCommand {
        + LockCommand()
        + LockCommand(String, String, CommandType)
        + lock(String, String) : LockCommand
        + unlock(String, String) : LockCommand
        + renew(String, String) : LockCommand
        + getLockName() : String
        + getNodeId() : String
        + getCommandType() : LockCommand_CommandType
        - lockName : String
        - nodeId : String
        - commandType : LockCommand_CommandType
        - timestamp : long
    }

    enum LockCommand_CommandType {
        LOCK
        UNLOCK
        RENEW
    }

    class LockEntry {
        + LockEntry(String)
        + isHeld() : boolean
        + isHeldBy(String) : boolean
        + isLeaseExpired() : boolean
        + tryAcquire(String, long) : boolean
        + release(String) : boolean
        + renew(String, long) : boolean
        - lockName : String
        - nodeId : String
        - holdCount : int
        - leaseExpireTime : long
    }

    class LockStateMachine {
        + LockStateMachine()
        + apply(LogEntry) : void
        + snapshot(String) : void
        + restore(String) : void
        + getLastAppliedIndex() : long
        + isLockHeldBy(String, String) : boolean
        + isLockAvailable(String, String) : boolean
        - applyCommand(LockCommand) : void
        - lockTable : ConcurrentHashMap~String,LockEntry~
        - serializer : ProtostuffSerializer
        - lastAppliedIndex : long
    }

    DistributedLockImpl ..|> DistributedLock
    DistributedLockImpl o-- LockHandle
    DistributedLockImpl o-- RaftNode
    DistributedLockImpl o-- LockStateMachine
    LockStateMachine ..|> StateMachine
    LockStateMachine o-- "0..*" LockEntry
    LockStateMachine o-- ProtostuffSerializer
    LockStateMachine ..> LockCommand
    LockCommand *-- LockCommand_CommandType
    LockHandle <|-- AutoCloseable
}

